8e8","type":"altText","model":{"blocks":[{"id":"1257e1d7","type":"text","model":{"blocks":[{"id":"2c3b95f5","type":"paragraph","model":{"text":"一幅手繪風格插圖顯示兩名人士分別站在畫面左右兩側，手持鮮粉紅色雙筒望遠鏡觀察前方的一棵樹。樹木以藍色和淺藍色描繪，樹枝中央停着一隻粉紅色小鳥。兩人均將望遠鏡對準樹上的鳥類，呈專注觀察姿態。","blocks":[{"id":"da7d0c20","type":"fragment","model":{"text":"一幅手繪風格插圖顯示兩名人士分別站在畫面左右兩側，手持鮮粉紅色雙筒望遠鏡觀察前方的一棵樹。樹木以藍色和淺藍色描繪，樹枝中央停着一隻粉紅色小鳥。兩人均將望遠鏡對準樹上的鳥類，呈專注觀察姿態。","attributes":[]},"position":[2,1,1,1,1]}]},"position":[2,1,1,1]}]},"position":[2,1,1]}]},"position":[2,1]},{"id":"75a4f93e","type":"rawImage","model":{"width":800,"height":450,"locator":"519e/live/96210a20-d01e-11f1-a701-fddedf244c16.jpg","originCode":"cpsprodpb","copyrightHolder":"BBC/Serenity Strull","suitableForSyndication":true},"position":[2,2]}]},"position":[2]},{"id":"03623836","type":"byline","model":{"blocks":[{"id":"55ab3aa2","type":"contributor","model":{"blocks":[{"id":"e93c0ab0","type":"name","model":{"blocks":[{"id":"af2e3873","type":"text","model":{"blocks":[{"id":"3b15bc9c","type":"paragraph","model":{"text":"貝卡·華納（Becca Warner）","blocks":[{"id":"16debf5d","type":"fragment","model":{"text":"貝卡·華納（Becca Warner）","attributes":[]},"position":[3,1,1,1,1,1]}]},"position":[3,1,1,1,1]}]},"position":[3,1,1,1]}]},"position":[3,1,1]},{"id":"afff47e7","type":"role","model":{"blocks":[{"id":"fe4eb68a","type":"text","model":{"blocks":[{"id":"eedbf42b","type":"paragraph","model":{"text":"","blocks":[{"id":"7f11051e","type":"fragment","model":{"text":"","attributes":[]},"position":[3,1,2,1,1,1]}]},"position":[3,1,2,1,1]}]},"position":[3,1,2,1]}]},"position":[3,1,2]}]},"position":[3,1]}]},"position":[3]},{"id":"9e983a0c","type":"disclaimer","model":{},"position":[4]},{"type":"disclaimer","model":{}},{"id":"3d66f129","type":"timestamp","model":{"firstPublished":1792909857828,"lastPublished":1792909857828},"position":[5]},{"id":"62bcb0f1","type":"text","model":{"blocks":[{"id":"1f1eab0e","type":"paragraph","model":{"text":"觀鳥有助減緩大腦老化，近年更愈來愈多被用作認知障礙症（失智症）患者的治療輔助活動。","blocks":[{"id":"ec517f2c","type":"fragment","model":{"text":"觀鳥有助減緩大腦老化，近年更愈來愈多被用作認知障礙症（失智症）患者的治療輔助活動。","attributes":[]},"position":[6,1,1]}]},"position":[6,1]},{"id":"104b5688","type":"paragraph","model":{"text":"每個星期，一群年長的觀鳥愛好者都會在英國鄉郊的一座木製觀鳥屋內待上好幾個小時。他們透過望遠鏡觀察雀鳥，興奮地分享各自的發現。一隻蠣鷸伸出又長又鮮艷的鳥喙，在布滿碎石的地面上探尋食物；兩隻鳳頭鸊鷉則在水中上下浮動，頭上的羽冠高高豎起。","blocks":[{"id":"f6640c8a","type":"fragment","model":{"text":"每個星期，一群年長的觀鳥愛好者都會在英國鄉郊的一座木製觀鳥屋內待上好幾個小時。他們透過望遠鏡觀察雀鳥，興奮地分享各自的發現。一隻蠣鷸伸出又長又鮮艷的鳥喙，在布滿碎石的地面上探尋食物；兩隻鳳頭鸊鷉則在水中上下浮動，頭上的羽冠高高豎起。","attributes":[]},"position":[6,2,1]}]},"position":[6,2]},{"id":"aab51412","type":"paragraph","model":{"text":"這群觀鳥者大多難以記起當天早些時候發生的事情，有些人甚至難以跟上別人的談話。但當他們談起英國西米德蘭茲郡福治米爾湖（Forge Mill Lake）周圍的雀鳥時，卻會變得興致勃勃。","blocks":[{"id":"def07e41","type":"fragment","model":{"text":"這群觀鳥者大多難以記起當天早些時候發生的事情，有些人甚至難以跟上別人的談話。但當他們談起英國西米德蘭茲郡福治米爾湖（Forge Mill Lake）周圍的雀鳥時，卻會變得興致勃勃。","attributes":[]},"position":[6,3,1]}]},"position":[6,3]},{"id":"81541f5c","type":"paragraph","model":{"text":"78歲的哈羅德（Harold，化名）是其中一員。年輕時的他熱愛戶外活動，但近年因認知障礙症而變得沉默寡言、焦慮不安。他的女兒露西（Lucy，化名）帶他來到這裡，希望換個環境、看看寧靜的湖景，對他有好處。","blocks":[{"id":"727df4eb","type":"fragment","model":{"text":"78歲的哈羅德（Harold，化名）是其中一員。年輕時的他熱愛戶外活動，但近年因認知障礙症而變得沉默寡言、焦慮不安。他的女兒露西（Lucy，化名）帶他來到這裡，希望換個環境、看看寧靜的湖景，對他有好處。","attributes":[]},"position":[6,4,1]}]},"position":[6,4]}]},"position":[6]},{"id":"a97b1798","type":"continueReading","model":{},"position":[7]},{"id":"281a77f0","type":"text","model":{"blocks":[{"id":"70967396","type":"paragraph","model":{"text":"哈羅德起初有些不安，但當有人指着一隻歐亞鴝讓他看時，他開始露出笑容，也很享受觀看鴨子在水中嬉戲。藍山雀在附近的樹木間穿梭，露西更看到父親露出了久違的笑聲。","blocks":[{"id":"4267f0e0","type":"fragment","model":{"text":"哈羅德起初有些不安，但當有人指着一隻歐亞鴝讓他看時，他開始露出笑容，也很享受觀看鴨子在水中嬉戲。藍山雀在附近的樹木間穿梭，露西更看到父親露出了久違的笑聲。","attributes":[]},"position":[8,1,1]}]},"position":[8,1]}]},"position":[8]},{"id":"c9824d18","type":"mpu","model":{},"position":[9]},{"id":"9f1b6f3d","type":"text","model":{"blocks":[{"id":"18113fb1","type":"paragraph","model":{"text":"負責營運這個觀鳥小組的英國慈善機構Age UK，社區認知障礙症顧問珍妮·布丁格（Jenny Budinger）表示：「在那一刻，他真正活在當下，不再擔心自己的記憶力，也不再擔心失去自信。這是十分強大、且溫和方式發揮的力量。」","blocks":[{"id":"88bd7642","type":"fragment","model":{"text":"負責營運這個觀鳥小組的英國慈善機構Age UK，社區認知障礙症顧問珍妮·布丁格（Jenny Budinger）表示：「在那一刻，他真正活在當下，不再擔心自己的記憶力，也不再擔心失去自信。這是十分強大、且溫和方式發揮的力量。」","attributes":[]},"position":[10,1,1]}]},"position":[10,1]}]},"position":[10]},{"id":"f27a98a1","type":"text","model":{"blocks":[{"id":"dc0a94e0","type":"paragraph","model":{"text":"觀鳥愈來愈被視為有益長者和認知障礙症患者的活動。英國、德國和美國的安老院舍，都已成立觀鳥小組。即使只是透過窗戶留意鳥類活動，也有助長者增強與他人的聯繫感、獲得更多正面情緒，並提升記憶能力。","blocks":[{"id":"68d9052c","type":"fragment","model":{"text":"觀鳥愈來愈被視為有益長者和認知障礙症患者的活動。英國、德國和美國的安老院舍，都已成立觀鳥小組。即使只是透過窗戶留意鳥類活動，也有助長者增強與他人的聯繫感、獲得更多正面情緒，並提升記憶能力。","attributes":[]},"position":[11,1,1]}]},"position":[11,1]}]},"position":[11]},{"id":"e4b5bf56","type":"text","model":{"blocks":[{"id":"a9321382","type":"paragraph","model":{"text":"如今，新的研究更顯示，觀鳥能夠像學習運動或演奏樂器一樣，重新塑造大腦結構，甚至有助減緩大腦老化過程。","blocks":[{"id":"9411753c","type":"fragment","model":{"text":"如今，新的研究更顯示，觀鳥能夠像學習運動或演奏樂器一樣，重新塑造大腦結構，甚至有助減緩大腦老化過程。","attributes":[]},"position":[12,1,1]}]},"position":[12,1]}]},"position":[12]},{"id":"4c874b4e","type":"wsoj","model":{"type":"recommendations","data":[{"id":"urn:bbc:optimo:asset:c6rmydgej9w8o","title":"住着一群代孕孩子，美國加州的豪宅如何變成「恐怖之家」？","href":"https://www.bbc.com/zhongwen/articles/c6rmydgej9w8o/trad","image":{"width":1296,"height":860,"altText":"張莎莎身穿白色T恤、雙手放在身後，在法庭內坐在宣國軍旁邊。宣國軍是一名禿頭的中年男子，兩人身後各有執法人員站立。","copyrightHolder":"Getty Images","originCode":"cpsprodpb","locator":"654c/live/26d45cf0-ceff-11f1-93e1-3b657b665bcf.png"}},{"id":"urn:bbc:optimo:asset:cwg7xy2mjnl0o","title":"中國市場放緩，英國傳統精英私立學校紛紛進軍印度","href":"https://www.bbc.com/zhongwen/articles/cwg7xy2mjnl0o/trad","image":{"width":4869,"height":2738,"altText":"班加羅爾哈羅學校的學生們坐在花園裡，穿著傳統制服和帽子，望著主樓。","copyrightHolder":"Harrow School, Bengaluru","originCode":"cpsprodpb","locator":"35df/live/96c0ab50-c5f3-11f1-82a9-255f3002ddb8.jpg"}},{"id":"urn:bbc:optimo:asset:ckq6nvg7ny1yo","title":"法國再爆大規模示威逾1300人被捕，警民衝突致53警受傷","href":"https://www.bbc.com/zhongwen/articles/ckq6nvg7ny1yo/trad","image":{"width":1729,"height":972,"altText":"People clash with police officers as objects burn at a barricade during a demonstration against the high cost of living in Bordeaux, France.","copyrightHolder":"EPA","originCode":"cpsprodpb","locator":"3d00/live/edf93830-cffb-11f1-b444-6fb1f13f8d87.jpg"}},{"id":"urn:bbc:optimo:asset:ckx2q587wvrqo","title":"中共五中全會今日開幕：十三年反腐後，如何繼續「從嚴治黨」？","href":"https://www.bbc.com/zhongwen/articles/ckx2q587wvrqo/trad","image":{"width":973,"height":547,"altText":"圖為 2022 年 10 月召開的中共二十大，當前（2026.10）舉行的為中共二十大五中全會，一般一屆黨代會召開七次全會","copyrightHolder":"Getty Images","originCode":"cpsprodpb","locator":"f57d/live/79185170-d0de-11f1-ad70-07daa2562508.jpg"}}]},"position":[13]},{"id":"0590a4f3","type":"subheadline","model":{"blocks":[{"id":"a5ffdb7f","type":"text","model":{"blocks":[{"id":"c6a559cb","type":"paragraph","model":{"text":"組織更強的大腦","blocks":[{"id":"d7cc7ee1","type":"fragment","model":{"text":"組織更強的大腦","attributes":[]},"position":[14,1,1,1]}]},"position":[14,1,1]}]},"position":[14,1]}]},"position":[14]},{"id":"3e44ecdb","type":"text","model":{"blocks":[{"id":"5a4d3291","type":"paragraph","model":{"text":"與此同時，在實驗室裡，神經科學家正研究觀鳥活動如何影響大腦。","blocks":[{"id":"7789e018","type":"fragment","model":{"text":"與此同時，在實驗室裡，神經科學家正研究觀鳥活動如何影響大腦。","attributes":[]},"position":[15,1,1]}]},"position":[15,1]},{"id":"e14d68d1","type":"paragraph","model":{"text":"他們測試資深觀鳥者辨認鳥類的能力，以區分專家和新手，然後分析他們的大腦。","blocks":[{"id":"50e6a1b7","type":"fragment","model":{"text":"他們測試資深觀鳥者辨認鳥類的能力，以區分專家和新手，然後分析他們的大腦。","attributes":[]},"position":[15,2,1]}]},"position":[15,2]},{"id":"18aa4d6d","type":"paragraph","model":{"text":"科學家發現，觀鳥專家的大腦結構有所不同。此外，觀鳥方面的專業能力或有助維持大腦較高的組織性，從而減緩與年齡相關的認知能力衰退。","blocks":[{"id":"8653a6a0","type":"fragment","model":{"text":"科學家發現，觀鳥專家的大腦結構有所不同。此外，觀鳥方面的專業能力或有助維持大腦較高的組織性，從而減緩與年齡相關的認知能力衰退。","attributes":[]},"position":[15,3,1]}]},"position":[15,3]},{"id":"2aa0def7","type":"paragraph","model":{"text":"埃里克·溫（Erik Wing）帶領加拿大多倫多貝克雷斯特研究及教育學院（Baycrest Academy for Research and Education）的研究項目，比較觀鳥專家和初學者在辨認鳥類時的腦部磁力共振（MRI）掃描結果，發現專家大腦在某些區域的連結方式有所不同，而這些區域與注意力、視覺感知及視覺辨認等功能密切相關。","blocks":[{"id":"3d4acdf8","type":"fragment","model":{"text":"埃里克·溫（Erik Wing）帶領加拿大多倫多貝克雷斯特研究及教育學院（Baycrest Academy for Research and Education）的研究項目，比較觀鳥專家和初學者在辨認鳥類時的腦部磁力共振（MRI）掃描結果，發現專家大腦在某些區域的連結方式有所不同，而這些區域與注意力、視覺感知及視覺辨認等功能密切相關。","attributes":[]},"position":[15,4,1]}]},"position":[15,4]},{"id":"beaba5e0","type":"paragraph","model":{"text":"在觀鳥專家身上，這些腦區的活動更為活躍，尤其是在辨認自己原本不熟悉的鳥類時更為明顯。","blocks":[{"id":"95a8c01c","type":"fragment","model":{"text":"在觀鳥專家身上，這些腦區的活動更為活躍，尤其是在辨認自己原本不熟悉的鳥類時更為明顯。","attributes":[]},"position":[15,5,1]}]},"position":[15,5]},{"id":"5c0beabd","type":"paragraph","model":{"text":"研究結果並未證明，究竟是大腦結構差異造就觀鳥專長，還是長期觀鳥改變大腦結構。","blocks":[{"id":"07e0ab5f","type":"fragment","model":{"text":"研究結果並未證明，究竟是大腦結構差異造就觀鳥專長，還是長期觀鳥改變大腦結構。","attributes":[]},"position":[15,6,1]}]},"position":[15,6]},{"id":"4b8a8ae2","type":"paragraph","model":{"text":"不過，溫表示，其中一種解釋是，負責觀鳥相關活動的大腦區域可能出現了「神經可塑性」（neuroplasticity）變化，也就是大腦隨時間改變其結構和功能的能力。","blocks":[{"id":"360d77aa","type":"fragment","model":{"text":"不過，溫表示，其中一種解釋是，負責觀鳥相關活動的大腦區域可能出現了「神經可塑性」（neuroplasticity）變化，也就是大腦隨時間改變其結構和功能的能力。","attributes":[]},"position":[15,7,1]}]},"position":[15,7]}]},"position":[15]},{"id":"241261d6","type":"image","model":{"blocks":[{"id":"b57b81bb","type":"caption","model":{"blocks":[{"id":"375c97c0","type":"text","model":{"blocks":[{"id":"7e164751","type":"paragraph","model":{"text":"觀鳥可以重塑大腦，並可能有助於延緩老化。","blocks":[{"id":"88f476e8","type":"fragment","model":{"text":"觀鳥可以重塑大腦，並可能有助於延緩老化。","attributes":[]},"position":[16,1,1,1,1]}]},"position":[16,1,1,1]}]},"position":[16,1,1]}]},"position":[16,1]},{"id":"eb2f4ed6","type":"altText","model":{"blocks":[{"id":"a21666db","type":"text","model":{"blocks":[{"id":"602eaa4f","type":"paragraph","model":{"text":"一幅手繪風格插圖描繪三名長者坐在高腳椅上，透過一個大型觀景窗觀察戶外的鳥類。左側一人手持粉紅色雙筒望遠鏡，中間一人直接望向窗外，右側一人則把粉紅色望遠鏡放在身前。窗外天空以淺藍色和白色筆觸描繪，一隻粉紅色鳥類正從窗前飛過。觀景窗上方懸掛一塊告示牌，寫有「SHHH! BIRD WATCHING IN PROGRESS」（噓！正在觀鳥中）。","blocks":[{"id":"31a5eee3","type":"fragment","model":{"text":"一幅手繪風格插圖描繪三名長者坐在高腳椅上，透過一個大型觀景窗觀察戶外的鳥類。左側一人手持粉紅色雙筒望遠鏡，中間一人直接望向窗外，右側一人則把粉紅色望遠鏡放在身前。窗外天空以淺藍色和白色筆觸描繪，一隻粉紅色鳥類正從窗前飛過。觀景窗上方懸掛一塊告示牌，寫有「SHHH! BIRD WATCHING IN PROGRESS」（噓！正在觀鳥中）。","attributes":[]},"position":[16,2,1,1,1]}]},"position":[16,2,1,1]}]},"position":[16,2,1]}]},"position":[16,2]},{"id":"009cd10b","type":"rawImage","model":{"width":800,"height":800,"locator":"146b/live/b52170e0-d01e-11f1-a701-fddedf244c16.jpg","originCode":"cpsprodpb","copyrightHolder":"BBC/Serenity Strull","suitableForSyndication":true},"position":[16,3]}]},"position":[16]},{"id":"df49b51c","type":"text","model":{"blocks":[{"id":"0d1641d8","type":"paragraph","model":{"text":"埃里克·溫還分析了觀鳥者大腦的組織化程度。","blocks":[{"id":"a8d86de9","type":"fragment","model":{"text":"埃里克·溫還分析了觀鳥者大腦的組織化程度。","attributes":[]},"position":[17,1,1]}]},"position":[17,1]},{"id":"5d8fe9c6","type":"paragraph","model":{"text":"隨著年齡增長，大腦的組織性通常會逐漸下降，而組織程度較低往往與認知能力衰退有關。不過，在觀鳥專家的大腦中，部分區域的組織性和連貫性水平高於同齡的新手。其中一些區域，正是先前在辨認鳥類時表現出較高活躍度的腦區。","blocks":[{"id":"55b4f160","type":"fragment","model":{"text":"隨著年齡增長，大腦的組織性通常會逐漸下降，而組織程度較低往往與認知能力衰退有關。不過，在觀鳥專家的大腦中，部分區域的組織性和連貫性水平高於同齡的新手。其中一些區域，正是先前在辨認鳥類時表現出較高活躍度的腦區。","attributes":[]},"position":[17,2,1]}]},"position":[17,2]},{"id":"2b717206","type":"paragraph","model":{"text":"溫表示，這顯示隨着專家年齡增長，其大腦在某種程度上仍能「保持原有的組織性」。","blocks":[{"id":"94304b1b","type":"fragment","model":{"text":"溫表示，這顯示隨着專家年齡增長，其大腦在某種程度上仍能「保持原有的組織性」。","attributes":[]},"position":[17,3,1]}]},"position":[17,3]},{"id":"c4d84587","type":"paragraph","model":{"text":"目前仍需要更多研究，才能了解這種保留現象的本質，以及它與整體認知功能之間的關係。但現階段的研究結果顯示，「如果在人生較早階段學會這項技能，其益處可能一直延續至老年時期」，溫稱。","blocks":[{"id":"81d8dfdc","type":"fragment","model":{"text":"目前仍需要更多研究，才能了解這種保留現象的本質，以及它與整體認知功能之間的關係。但現階段的研究結果顯示，「如果在人生較早階段學會這項技能，其益處可能一直延續至老年時期」，溫稱。","attributes":[]},"position":[17,4,1]}]},"position":[17,4]},{"id":"5a13b635","type":"paragraph","model":{"text":"這對許多早早拿起望遠鏡投入觀鳥活動的Z世代（16至29歲）而言，無疑是一個好消息。","blocks":[{"id":"01e340fa","type":"fragment","model":{"text":"這對許多早早拿起望遠鏡投入觀鳥活動的Z世代（16至29歲）而言，無疑是一個好消息。","attributes":[]},"position":[17,5,1]}]},"position":[17,5]}]},"position":[17]},{"id":"6b8bd771","type":"subheadline","model":{"blocks":[{"id":"73e2f4ef","type":"text","model":{"blocks":[{"id":"a06fa246","type":"paragraph","model":{"text":"鳥類療法","blocks":[{"id":"885eb7ec","type":"fragment","model":{"text":"鳥類療法","attributes":[]},"position":[18,1,1,1]}]},"position":[18,1,1]}]},"position":[18,1]}]},"position":[18]},{"id":"8eb7951f","type":"text","model":{"blocks":[{"id":"41075eef","type":"paragraph","model":{"text":"溫的研究聚焦於觀鳥專業技能，但其他研究發現，即使沒有特別的知識或技巧，觀鳥也可能帶來心理上的好處。","blocks":[{"id":"25ec6a0e","type":"fragment","model":{"text":"溫的研究聚焦於觀鳥專業技能，但其他研究發現，即使沒有特別的知識或技巧，觀鳥也可能帶來心理上的好處。","attributes":[]},"position":[19,1,1]}]},"position":[19,1]},{"id":"d81cd9ba","type":"paragraph","model":{"text":"事實上，如果要透過觀鳥獲得心理上的恢復，例如感到平靜、自由和重新充滿活力，熱情可能比專業能力更重要。","blocks":[{"id":"225a84fc","type":"fragment","model":{"text":"事實上，如果要透過觀鳥獲得心理上的恢復，例如感到平靜、自由和重新充滿活力，熱情可能比專業能力更重要。","attributes":[]},"position":[19,2,1]}]},"position":[19,2]},{"id":"0140b0c0","type":"paragraph","model":{"text":"波蘭一項針對388名觀鳥者的研究發現，那些認為觀鳥比其他活動更有吸引力，並把觀鳥視為生活重要部分的人，比起技術高超但熱情較低的觀鳥者，更容易獲得心理上的恢復感。","blocks":[{"id":"8a4d295f","type":"fragment","model":{"text":"波蘭一項針對388名觀鳥者的研究發現，那些認為觀鳥比其他活動更有吸引力，並把觀鳥視為生活重要部分的人，比起技術高超但熱情較低的觀鳥者，更容易獲得心理上的恢復感。","attributes":[]},"position":[19,3,1]}]},"position":[19,3]},{"id":"22a9143b","type":"paragraph","model":{"text":"換言之，單純培養對鳥類的興趣，本身便可能帶來益處。","blocks":[{"id":"589cf1c2","type":"fragment","model":{"text":"換言之，單純培養對鳥類的興趣，本身便可能帶來益處。","attributes":[]},"position":[19,4,1]}]},"position":[19,4]},{"id":"ebf60092","type":"paragraph","model":{"text":"德國艾希施泰特—因戈爾施塔特天主教大學（Catholic University of Eichstätt-Ingolstadt）的社會及組織心理學教授伊麗莎白·卡爾斯（Elisabeth Kals），一直關注人與大自然的關係如何影響生活經驗及身心健康。她研究了安老院舍住客有機會觀察附近野生雀鳥後，會出現甚麼變化。","blocks":[{"id":"16169f79","type":"fragment","model":{"text":"德國艾希施泰特—因戈爾施塔特天主教大學（Catholic University of Eichstätt-Ingolstadt）的社會及組織心理學教授伊麗莎白·卡爾斯（Elisabeth Kals），一直關注人與大自然的關係如何影響生活經驗及身心健康。她研究了安老院舍住客有機會觀察附近野生雀鳥後，會出現甚麼變化。","attributes":[]},"position":[19,5,1]}]},"position":[19,5]},{"id":"beac9870","type":"paragraph","model":{"text":"她的團隊在65間安老院舍外設置雀鳥餵食站，讓院友可以舒適地坐在室內公共空間觀鳥。研究人員透過院友的自我報告，以及院舍職員和家屬提供的資料，評估他們的認知能力、活動能力和身心健康狀況。","blocks":[{"id":"da66a202","type":"fragment","model":{"text":"她的團隊在65間安老院舍外設置雀鳥餵食站，讓院友可以舒適地坐在室內公共空間觀鳥。研究人員透過院友的自我報告，以及院舍職員和家屬提供的資料，評估他們的認知能力、活動能力和身心健康狀況。","attributes":[]},"position":[19,6,1]}]},"position":[19,6]},{"id":"c91bbee5","type":"paragraph","model":{"text":"短短幾個星期後，研究人員便觀察到改善。一個月後，觀鳥活動對院友身心健康狀況的解釋力，甚至超過了年齡和所需護理程度等因素。","blocks":[{"id":"65787379","type":"fragment","model":{"text":"短短幾個星期後，研究人員便觀察到改善。一個月後，觀鳥活動對院友身心健康狀況的解釋力，甚至超過了年齡和所需護理程度等因素。","attributes":[]},"position":[19,7,1]}]},"position":[19,7]},{"id":"26c32780","type":"paragraph","model":{"text":"卡爾斯表示：「研究結果非常正面。」","blocks":[{"id":"76e4e95c","type":"fragment","model":{"text":"卡爾斯表示：「研究結果非常正面。」","attributes":[]},"position":[19,8,1]}]},"position":[19,8]},{"id":"bcf26683","type":"paragraph","model":{"text":"她補充，參與觀鳥的院友在認知方面變得更加靈活。這意味着他們更能跟上對話、與前來探望的家人互動，也能記住並認出曾經出現的雀鳥，而且精神更加敏銳。","blocks":[{"id":"3aad2e27","type":"fragment","model":{"text":"她補充，參與觀鳥的院友在認知方面變得更加靈活。這意味着他們更能跟上對話、與前來探望的家人互動，也能記住並認出曾經出現的雀鳥，而且精神更加敏銳。","attributes":[]},"position":[19,9,1]}]},"position":[19,9]},{"id":"92017069","type":"paragraph","model":{"text":"最先留意到這些變化的是護老院員工。","blocks":[{"id":"088f41c1","type":"fragment","model":{"text":"最先留意到這些變化的是護老院員工。","attributes":[]},"position":[19,10,1]}]},"position":[19,10]},{"id":"f43843e0","type":"paragraph","model":{"text":"卡爾斯說：「有些院友好幾個星期都沒有露出笑容，而當他們開始觀鳥後，護理人員終於再次看見他們臉上的笑容。」","blocks":[{"id":"daf9b1cc","type":"fragment","model":{"text":"卡爾斯說：「有些院友好幾個星期都沒有露出笑容，而當他們開始觀鳥後，護理人員終於再次看見他們臉上的笑容。」","attributes":[]},"position":[19,11,1]}]},"position":[19,11]}]},"position":[19]},{"id":"bf677521","type":"text","model":{"blocks":[{"id":"5a20a0ba","type":"paragraph","model":{"text":"卡爾斯表示，部分記憶力和專注力方面的改善，在短短三至四星期後已經能夠察覺。","blocks":[{"id":"b8f246b8","type":"fragment","model":{"text":"卡爾斯表示，部分記憶力和專注力方面的改善，在短短三至四星期後已經能夠察覺。","attributes":[]},"position":[20,1,1]}]},"position":[20,1]},{"id":"056a860d","type":"paragraph","model":{"text":"她的團隊所取得的研究成果，促使德國多家醫療保險公司投資，在巴伐利亞州超過400間安老院舍設置雀鳥餵食器和觀鳥區。這些保險公司當中，有部分原本也是研究項目的資助者。","blocks":[{"id":"2b685d48","type":"fragment","model":{"text":"她的團隊所取得的研究成果，促使德國多家醫療保險公司投資，在巴伐利亞州超過400間安老院舍設置雀鳥餵食器和觀鳥區。這些保險公司當中，有部分原本也是研究項目的資助者。","attributes":[]},"position":[20,2,1]}]},"position":[20,2]},{"id":"aa5c4bcf","type":"paragraph","model":{"text":"卡爾斯說：「效果實在太好，甚至能節省開支。」","blocks":[{"id":"e24a4db4","type":"fragment","model":{"text":"卡爾斯說：「效果實在太好，甚至能節省開支。」","attributes":[]},"position":[20,3,1]}]},"position":[20,3]}]},"position":[20]},{"id":"55258042","type":"image","model":{"blocks":[{"id":"10e8a5e6","type":"caption","model":{"blocks":[{"id":"a1daa5e6","type":"text","model":{"blocks":[{"id":"ac094cf9","type":"paragraph","model":{"text":"即使透過窗戶觀察鳥類也會產生正面的影響。","blocks":[{"id":"fd4c5a27","type":"fragment","model":{"text":"即使透過窗戶觀察鳥類也會產生正面的影響。","attributes":[]},"position":[21,1,1,1,1]}]},"position":[21,1,1,1]}]},"position":[21,1,1]}]},"position":[21,1]},{"id":"262a98b0","type":"altText","model":{"blocks":[{"id":"1eefdeb5","type":"text","model":{"blocks":[{"id":"5c056f55","type":"paragraph","model":{"text":"一幅手繪風格插圖顯示一名長者坐在室內扶手椅上，面向窗戶觀察戶外景色。窗外可見一棵以藍色描繪的大樹，樹枝上懸掛著一個鳥屋。鳥屋入口停著一隻粉紅色小鳥。\n","blocks":[{"id":"c0c0f0b9","type":"fragment","model":{"text":"一幅手繪風格插圖顯示一名長者坐在室內扶手椅上，面向窗戶觀察戶外景色。窗外可見一棵以藍色描繪的大樹，樹枝上懸掛著一個鳥屋。鳥屋入口停著一隻粉紅色小鳥。\n","attributes":[]},"position":[21,2,1,1,1]}]},"position":[21,2,1,1]}]},"position":[21,2,1]}]},"position":[21,2]},{"id":"0867d382","type":"rawImage","model":{"width":800,"height":800,"locator":"6dbb/live/d37dcf70-d01e-11f1-a701-fddedf244c16.jpg","originCode":"cpsprodpb","copyrightHolder":"BBC/Serenity Strull","suitableForSyndication":true},"position":[21,3]}]},"position":[21]},{"id":"9bf9bb15","type":"podcastPromo","model":{"type":"podcastPromo"},"position":[22]},{"id":"a32c7b85","type":"text","model":{"blocks":[{"id":"7c5f91ed","type":"paragraph","model":{"text":"美國亦有類似計劃。2013年，康涅狄格州四個護理社區開始推行一項計劃，其後擴展至得克薩斯州和科羅拉多州。","blocks":[{"id":"4078c735","type":"fragment","model":{"text":"美國亦有類似計劃。2013年，康涅狄格州四個護理社區開始推行一項計劃，其後擴展至得克薩斯州和科羅拉多州。","attributes":[]},"position":[23,1,1]}]},"position":[23,1]},{"id":"4a10fc6b","type":"paragraph","model":{"text":"這項名為「Bird Tales」的治療計劃專為認知障礙症患者而設，在他們居住的設施安裝雀鳥餵食器，並提供能發出仿真鳥鳴聲的雀鳥毛公仔，讓患者認識不同鳥類。","blocks":[{"id":"f04823a6","type":"fragment","model":{"text":"這項名為「Bird Tales」的治療計劃專為認知障礙症患者而設，在他們居住的設施安裝雀鳥餵食器，並提供能發出仿真鳥鳴聲的雀鳥毛公仔，讓患者認識不同鳥類。","attributes":[]},"position":[23,2,1]}]},"position":[23,2]},{"id":"4232ed4b","type":"paragraph","model":{"text":"參與者普遍反映計劃成效正面。他們表示，活動有助刺激認知能力，並讓自己與過去的記憶重新建立聯繫。","blocks":[{"id":"6f2f2627","type":"fragment","model":{"text":"參與者普遍反映計劃成效正面。他們表示，活動有助刺激認知能力，並讓自己與過去的記憶重新建立聯繫。","attributes":[]},"position":[23,3,1]}]},"position":[23,3]},{"id":"9aca89a4","type":"paragraph","model":{"text":"類似項目亦為中風康復者帶來益處。部分中風患者會出現失語症（aphasia），即說話或理解語言能力受損。","blocks":[{"id":"edcef2a1","type":"fragment","model":{"text":"類似項目亦為中風康復者帶來益處。部分中風患者會出現失語症（aphasia），即說話或理解語言能力受損。","attributes":[]},"position":[23,4,1]}]},"position":[23,4]},{"id":"0dbfaeb9","type":"paragraph","model":{"text":"美國蒙大拿大學（University of Montana）的「深入綜合失語症計劃」（Intensive Comprehensive Aphasia Program）於2021年開始安排參加者觀察貓頭鷹，如今已擴展至在專人指導下觀察蒙大拿州各種雀鳥，並辨認牠們的叫聲。","blocks":[{"id":"58756bdf","type":"fragment","model":{"text":"美國蒙大拿大學（University of Montana）的「深入綜合失語症計劃」（Intensive Comprehensive Aphasia Program）於2021年開始安排參加者觀察貓頭鷹，如今已擴展至在專人指導下觀察蒙大拿州各種雀鳥，並辨認牠們的叫聲。","attributes":[]},"position":[23,5,1]}]},"position":[23,5]}]},"position":[23]},{"id":"7f292da8","type":"text","model":{"blocks":[{"id":"27856e30","type":"paragraph","model":{"text":"為甚麼觀鳥會對人的感受和思維產生如此正面的影響？","blocks":[{"id":"d14ededf","type":"fragment","model":{"text":"為甚麼觀鳥會對人的感受和思維產生如此正面的影響？","attributes":[]},"position":[24,1,1]}]},"position":[24,1]},{"id":"88baaa66","type":"paragraph","model":{"text":"卡爾斯認為，「這不單是關於鳥類本身，而是大自然、專注力、情感、意義、社交交流和活動，以一種非常簡單的方式結合在一起。它能創造一些微小的時刻，包括好奇心、愉悅感和期待感。」","blocks":[{"id":"0f1a2428","type":"fragment","model":{"text":"卡爾斯認為，「這不單是關於鳥類本身，而是大自然、專注力、情感、意義、社交交流和活動，以一種非常簡單的方式結合在一起。它能創造一些微小的時刻，包括好奇心、愉悅感和期待感。」","attributes":[]},"position":[24,2,1]}]},"position":[24,2]},{"id":"f82e0581","type":"paragraph","model":{"text":"她補充說，觀鳥「非常容易參與」。","blocks":[{"id":"5f1d2700","type":"fragment","model":{"text":"她補充說，觀鳥「非常容易參與」。","attributes":[]},"position":[24,3,1]}]},"position":[24,3]},{"id":"932daf65","type":"paragraph","model":{"text":"這或許解釋了為何在英國一項針對認知障礙症患者及其照顧者的調查中，觀察鳥類及其他野生動物成為僅次於在大自然中散步的第二受歡迎戶外活動。","blocks":[{"id":"c6863f0d","type":"fragment","model":{"text":"這或許解釋了為何在英國一項針對認知障礙症患者及其照顧者的調查中，觀察鳥類及其他野生動物成為僅次於在大自然中散步的第二受歡迎戶外活動。","attributes":[]},"position":[24,4,1]}]},"position":[24,4]},{"id":"f4032a02","type":"paragraph","model":{"text":"同一項調查亦發現，交通和出行便利性是認知障礙症患者的重要考慮因素。對於能夠透過廚房窗戶看見鳥類的人來說，這些障礙可能大大減少。","blocks":[{"id":"d8747a19","type":"fragment","model":{"text":"同一項調查亦發現，交通和出行便利性是認知障礙症患者的重要考慮因素。對於能夠透過廚房窗戶看見鳥類的人來說，這些障礙可能大大減少。","attributes":[]},"position":[24,5,1]}]},"position":[24,5]},{"id":"b33be2a5","type":"paragraph","model":{"text":"埃里克·溫表示，觀鳥是一種探索好奇心的方式，而這份好奇心本身或許正是如此有益的原因。","blocks":[{"id":"87c1f7f3","type":"fragment","model":{"text":"埃里克·溫表示，觀鳥是一種探索好奇心的方式，而這份好奇心本身或許正是如此有益的原因。","attributes":[]},"position":[24,6,1]}]},"position":[24,6]},{"id":"85c1e119","type":"paragraph","model":{"text":"溫說：「我認為，在中年以至持續步入老年階段時，為生活加入更多新鮮感和新體驗，能帶來許多好處。」","blocks":[{"id":"90f78e67","type":"fragment","model":{"text":"溫說：「我認為，在中年以至持續步入老年階段時，為生活加入更多新鮮感和新體驗，能帶來許多好處。」","attributes":[]},"position":[24,7,1]}]},"position":[24,7]},{"id":"cc0aa04c","type":"paragraph","model":{"text":"好奇心在維持晚年認知功能方面扮演重要角色，部分原因可能是它能激活大腦中的去甲腎上腺素（正腎上腺素）和多巴胺，而這兩種物質具有正面且抗發炎的作用。","blocks":[{"id":"8e924b74","type":"fragment","model":{"text":"好奇心在維持晚年認知功能方面扮演重要角色，部分原因可能是它能激活大腦中的去甲腎上腺素（正腎上腺素）和多巴胺，而這兩種物質具有正面且抗發炎的作用。","attributes":[]},"position":[24,8,1]}]},"position":[24,8]},{"id":"27d59b8d","type":"paragraph","model":{"text":"對卡爾斯而言，認識那些在我們身邊鳴叫、翱翔的鳥類，也是一種重新認識自己的方式。","blocks":[{"id":"99882140","type":"fragment","model":{"text":"對卡爾斯而言，認識那些在我們身邊鳴叫、翱翔的鳥類，也是一種重新認識自己的方式。","attributes":[]},"position":[24,9,1]}]},"position":[24,9]},{"id":"89dcb791","type":"paragraph","model":{"text":"她說：「作為人類，我們原本就是大自然的一部分，但很可惜，我們在人生很早期便逐漸失去了這種聯繫。（觀鳥）是一種重新建立這種聯繫的方法，而且它十分簡單。」","blocks":[{"id":"5bf23c1b","type":"fragment","model":{"text":"她說：「作為人類，我們原本就是大自然的一部分，但很可惜，我們在人生很早期便逐漸失去了這種聯繫。（觀鳥）是一種重新建立這種聯繫的方法，而且它十分簡單。」","attributes":[]},"position":[24,10,1]}]},"position":[24,10]},{"id":"93d37019","type":"paragraph","model":{"text":"*為保障私隱，文中部分人物使用化名。","blocks":[{"id":"ff12e915","type":"fragment","model":{"text":"*為保障私隱，文中部分人物使用化名。","attributes":["italic"]},"position":[24,11,1]}]},"position":[24,11]}]},"position":[24]},{"id":"c433f20d","type":"text","model":{"blocks":[{"id":"c37bfa2c","type":"paragraph","model":{"text":"我們使用了人工智慧協助翻譯這篇文章，它的原文是英文。在發佈之前，BBC記者檢查了翻譯的內容。","blocks":[{"id":"8a639958","type":"fragment","model":{"text":"我們使用了人工智慧協助翻譯這篇文章，它的原文是英文。在發佈之前，BBC記者檢查了翻譯的內容。","attributes":[]},"position":[25,1,1]}]},"position":[25,1]},{"id":"cd59c74c","type":"paragraph","model":{"text":"按此了解我們如何使用人工智慧。","blocks":[{"id":"4a292ec9","type":"urlLink","model":{"text":"按此了解我們如何使用人工智慧","blocks":[{"id":"bea00b04","type":"fragment","model":{"text":"按此了解我們如何使用人工智慧","attributes":[]},"position":[25,2,1,1]}],"locator":"https://www.bbc.com/mediacentre/articles/2024/update-generative-ai-and-ai-tools-bbc","isExternal":false},"position":[25,2,1]},{"id":"dc6fc569","type":"fragment","model":{"text":"。","attributes":[]},"position":[25,2,2]}]},"position":[25,2]}]},"position":[25]},{"id":"98cb7562","type":"relatedContent","model":{"blocks":[{"id":"ee5bc064","type":"link","model":{"locator":"urn:bbc:optimo:asset:crkp6ke3vd0o","blocks":[{"id":"e302f368","type":"image","model":{"blocks":[{"id":"c4439a96","type":"altText","model":{"blocks":