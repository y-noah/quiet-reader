ableForSyndication":true},"position":[13,2]}]},"position":[13]},{"id":"0cdbd99a","type":"subheadline","model":{"blocks":[{"id":"ce645896","type":"text","model":{"blocks":[{"id":"071045dd","type":"paragraph","model":{"text":"十三年反腐，如何继续“从严治党”","blocks":[{"id":"b7c51432","type":"fragment","model":{"text":"十三年反腐，如何继续“从严治党”","attributes":[]},"position":[14,1,1,1]}]},"position":[14,1,1]}]},"position":[14,1]}]},"position":[14]},{"id":"c5e1a5a0","type":"text","model":{"blocks":[{"id":"49554e25","type":"paragraph","model":{"text":"中共反腐在习近平2012年底上台之后，开启“风暴”模式，“打虎拍蝇”成为中国人耳熟能详的政治语码。“老虎”通常指中央管理的副部级以上官员；“苍蝇”指查处基层腐败官员。","blocks":[{"id":"652ae453","type":"fragment","model":{"text":"中共反腐在习近平2012年底上台之后，开启“风暴”模式，“打虎拍蝇”成为中国人耳熟能详的政治语码。“老虎”通常指中央管理的副部级以上官员；“苍蝇”指查处基层腐败官员。","attributes":[]},"position":[15,1,1]}]},"position":[15,1]},{"id":"9c2d694e","type":"paragraph","model":{"text":"落马的中管官员人数近年持续攀升，根据中纪委披露，2025年立案审查调查的中管干部181人，比2024年的92人增加近一倍。同期立案县处级干部4.1万人，立案乡科级干部13.7万人。","blocks":[{"id":"f5a6f5b4","type":"fragment","model":{"text":"落马的中管官员人数近年持续攀升，根据中纪委披露，2025年立案审查调查的中管干部181人，比2024年的92人增加近一倍。同期立案县处级干部4.1万人，立案乡科级干部13.7万人。","attributes":[]},"position":[15,2,1]}]},"position":[15,2]},{"id":"2bd5a122","type":"paragraph","model":{"text":"魏德曼说：“过去十几年里，习近平的反腐运动累积了惊人的战果，但他并没有赢得这场战争。”他指出，反腐的目的不只是查处，更在形成威慑，让涉腐者收手，让未涉腐者不敢越界，但高官落马数量长期居高不下，说明这一效果没有达到预期。他说，许多今天落马的“老虎”，在中层任上就已涉腐，有的持续十年、十五年，期间不仅逃过查处，还一路升迁。","blocks":[{"id":"90973598","type":"fragment","model":{"text":"魏德曼说：“过去十几年里，习近平的反腐运动累积了惊人的战果，但他并没有赢得这场战争。”他指出，反腐的目的不只是查处，更在形成威慑，让涉腐者收手，让未涉腐者不敢越界，但高官落马数量长期居高不下，说明这一效果没有达到预期。他说，许多今天落马的“老虎”，在中层任上就已涉腐，有的持续十年、十五年，期间不仅逃过查处，还一路升迁。","attributes":[]},"position":[15,3,1]}]},"position":[15,3]},{"id":"673897df","type":"paragraph","model":{"text":"对于外界所说的“越反越腐”，他并不认为是反腐催生了更多腐败。更准确的说法是，十三年高压反腐，仍未完全改变官员的行为模式。","blocks":[{"id":"9cdf51cd","type":"fragment","model":{"text":"对于外界所说的“越反越腐”，他并不认为是反腐催生了更多腐败。更准确的说法是，十三年高压反腐，仍未完全改变官员的行为模式。","attributes":[]},"position":[15,4,1]}]},"position":[15,4]}]},"position":[15]},{"id":"cea7b508","type":"image","model":{"blocks":[{"id":"4b91a600","type":"altText","model":{"blocks":[{"id":"b3f88826","type":"text","model":{"blocks":[{"id":"5ac6a30c","type":"paragraph","model":{"text":"着正装的一排人站在人民大会堂里，背景挂着横幅“全面贯彻习近平新时代中国特色社会主义思想”","blocks":[{"id":"4980f6e6","type":"fragment","model":{"text":"着正装的一排人站在人民大会堂里，背景挂着横幅“全面贯彻习近平新时代中国特色社会主义思想”","attributes":[]},"position":[16,1,1,1,1]}]},"position":[16,1,1,1]}]},"position":[16,1,1]}]},"position":[16,1]},{"id":"2283411e","type":"rawImage","model":{"width":1024,"height":576,"locator":"1912/live/3a0928e0-cd07-11f1-8628-29c4e163232f.jpg","originCode":"cpsprodpb","copyrightHolder":"Getty Images","suitableForSyndication":true},"position":[16,2]}]},"position":[16]},{"id":"8b0a24fc","type":"subheadline","model":{"blocks":[{"id":"e6e2094e","type":"text","model":{"blocks":[{"id":"645cffbc","type":"paragraph","model":{"text":"被污染的池子中，如何选人？","blocks":[{"id":"aea7dd46","type":"fragment","model":{"text":"被污染的池子中，如何选人？","attributes":[]},"position":[17,1,1,1]}]},"position":[17,1,1]}]},"position":[17,1]}]},"position":[17]},{"id":"acf64e56","type":"text","model":{"blocks":[{"id":"78078476","type":"paragraph","model":{"text":"魏德曼认为，习近平如今面对的，已不再主要是前任时期提拔的官员。“现在他真正不得不面对的，是那些在他任内被提拔上来的人当中的腐败问题。”他形容，习近平把落马的“老虎”清除，再提拔新人接替，却发现自己是在一个已被污染的池子里挑人。在他看来，问题未必只存在于个别官员或特定派系，而可能与整个干部选拔机制有关。","blocks":[{"id":"e35b9290","type":"fragment","model":{"text":"魏德曼认为，习近平如今面对的，已不再主要是前任时期提拔的官员。“现在他真正不得不面对的，是那些在他任内被提拔上来的人当中的腐败问题。”他形容，习近平把落马的“老虎”清除，再提拔新人接替，却发现自己是在一个已被污染的池子里挑人。在他看来，问题未必只存在于个别官员或特定派系，而可能与整个干部选拔机制有关。","attributes":[]},"position":[18,1,1]}]},"position":[18,1]},{"id":"4262077a","type":"paragraph","model":{"text":"他还留意到，许多落马官员近年公开发表的忏悔录，叙事高度相似：从怀抱理想、服务人民开始，进入体制后逐步受环境影响，最终走向腐败，落马后完成悔悟。他认为，这种公式化的自白，反映官方倾向把腐败归因于个人道德失守。但如果大量官员讲述几乎相同的故事，问题是否仅在个人道德？","blocks":[{"id":"d3517647","type":"fragment","model":{"text":"他还留意到，许多落马官员近年公开发表的忏悔录，叙事高度相似：从怀抱理想、服务人民开始，进入体制后逐步受环境影响，最终走向腐败，落马后完成悔悟。他认为，这种公式化的自白，反映官方倾向把腐败归因于个人道德失守。但如果大量官员讲述几乎相同的故事，问题是否仅在个人道德？","attributes":[]},"position":[18,2,1]}]},"position":[18,2]},{"id":"c3912412","type":"paragraph","model":{"text":"他分析，改革开放后的经济高速增长和市场化，改变了官员的激励方式。相比毛泽东时代强调的集体主义和奉献精神，如今许多官员更倾向于把个人、家庭和未来发展纳入考量。习近平透过意识形态教育和党建工作，试图重建官员的服从意识与使命感，但魏德曼认为效果并不明显。","blocks":[{"id":"e3ee169d","type":"fragment","model":{"text":"他分析，改革开放后的经济高速增长和市场化，改变了官员的激励方式。相比毛泽东时代强调的集体主义和奉献精神，如今许多官员更倾向于把个人、家庭和未来发展纳入考量。习近平透过意识形态教育和党建工作，试图重建官员的服从意识与使命感，但魏德曼认为效果并不明显。","attributes":[]},"position":[18,3,1]}]},"position":[18,3]},{"id":"f0e50a5a","type":"paragraph","model":{"text":"牛犇同样认为，反腐如今已是持续性的组织整顿机制，而不再是派系斗争。于是，五中全会再次强调“全面从严治党”，一个难以回避的问题是：中共能否改变滋生腐败的制度环境和官僚文化，还是只能继续靠更严格的监督与惩罚维持运转？","blocks":[{"id":"ea50e864","type":"fragment","model":{"text":"牛犇同样认为，反腐如今已是持续性的组织整顿机制，而不再是派系斗争。于是，五中全会再次强调“全面从严治党”，一个难以回避的问题是：中共能否改变滋生腐败的制度环境和官僚文化，还是只能继续靠更严格的监督与惩罚维持运转？","attributes":[]},"position":[18,4,1]}]},"position":[18,4]}]},"position":[18]},{"id":"82037b96","type":"image","model":{"blocks":[{"id":"4b22f9ea","type":"altText","model":{"blocks":[{"id":"cd19a41d","type":"text","model":{"blocks":[{"id":"8ec8741b","type":"paragraph","model":{"text":"游客在博物馆中共党旗下参观","blocks":[{"id":"ab16461e","type":"fragment","model":{"text":"游客在博物馆中共党旗下参观","attributes":[]},"position":[19,1,1,1,1]}]},"position":[19,1,1,1]}]},"position":[19,1,1]}]},"position":[19,1]},{"id":"3902ac80","type":"rawImage","model":{"width":949,"height":534,"locator":"f6a3/live/a6178a10-ce1d-11f1-906e-e3128518d85d.jpg","originCode":"cpsprodpb","copyrightHolder":"Getty Images","suitableForSyndication":true},"position":[19,2]}]},"position":[19]},{"id":"f5f21d91","type":"subheadline","model":{"blocks":[{"id":"0fe06d43","type":"text","model":{"blocks":[{"id":"1a11abde","type":"paragraph","model":{"text":"“安全着陆”不再存在？","blocks":[{"id":"a0072d9f","type":"fragment","model":{"text":"“安全着陆”不再存在？","attributes":[]},"position":[20,1,1,1]}]},"position":[20,1,1]}]},"position":[20,1]}]},"position":[20]},{"id":"0eea9a8e","type":"text","model":{"blocks":[{"id":"1303f439","type":"paragraph","model":{"text":"会前，叶建春、曾与薄熙来共事的黄奇帆相继被查，外界讨论“安全着陆”是否已不复存在。","blocks":[{"id":"a9409cbf","type":"fragment","model":{"text":"会前，叶建春、曾与薄熙来共事的黄奇帆相继被查，外界讨论“安全着陆”是否已不复存在。","attributes":[]},"position":[21,1,1]}]},"position":[21,1]},{"id":"ca95d5de","type":"paragraph","model":{"text":"香港大学政治与公共行政学系副教授朱江南表示，目前这一轮密集的反腐传递出即使退休、离任也没有所谓安全着陆的讯号，表达中央反腐没有放松的意图。","blocks":[{"id":"6e3ae696","type":"fragment","model":{"text":"香港大学政治与公共行政学系副教授朱江南表示，目前这一轮密集的反腐传递出即使退休、离任也没有所谓安全着陆的讯号，表达中央反腐没有放松的意图。","attributes":[]},"position":[21,2,1]}]},"position":[21,2]},{"id":"37442608","type":"paragraph","model":{"text":"魏德曼说，他从不相信中共官场存在真正的安全着陆，1995年的陈希同、2006年的陈良宇，以及后来的周永康、薄熙来都是例证。","blocks":[{"id":"afd37afc","type":"fragment","model":{"text":"魏德曼说，他从不相信中共官场存在真正的安全着陆，1995年的陈希同、2006年的陈良宇，以及后来的周永康、薄熙来都是例证。","attributes":[]},"position":[21,3,1]}]},"position":[21,3]},{"id":"a0e7062c","type":"paragraph","model":{"text":"至于黄奇帆为何落马，他认为目前很难判断：可能与重庆任期有关，可能与上海时期有关，可能与退休后的金融圈人脉有关，也可能纯粹是“政治祭旗”。","blocks":[{"id":"edb6c040","type":"fragment","model":{"text":"至于黄奇帆为何落马，他认为目前很难判断：可能与重庆任期有关，可能与上海时期有关，可能与退休后的金融圈人脉有关，也可能纯粹是“政治祭旗”。","attributes":[]},"position":[21,4,1]}]},"position":[21,4]},{"id":"ed807b96","type":"paragraph","model":{"text":"牛犇则认为，黄奇帆是专业技术官僚，他的落马显示当下的反腐已超越传统派系划分，更聚焦政治忠诚、风险控制和组织纪律。","blocks":[{"id":"8665eefa","type":"fragment","model":{"text":"牛犇则认为，黄奇帆是专业技术官僚，他的落马显示当下的反腐已超越传统派系划分，更聚焦政治忠诚、风险控制和组织纪律。","attributes":[]},"position":[21,5,1]}]},"position":[21,5]},{"id":"e172c658","type":"paragraph","model":{"text":"五中全会也是观察二十一大前人事布局的重要窗口。近年多名中央委员落马，部分政治局职位出现空缺，这些位置是否会有新安排，是外界关注的焦点。","blocks":[{"id":"b85944c4","type":"fragment","model":{"text":"五中全会也是观察二十一大前人事布局的重要窗口。近年多名中央委员落马，部分政治局职位出现空缺，这些位置是否会有新安排，是外界关注的焦点。","attributes":[]},"position":[21,6,1]}]},"position":[21,6]},{"id":"c4720dde","type":"paragraph","model":{"text":"此外，中国政坛至今没有明确的接班人。魏德曼和牛犇都认为，这反映习近平面临两难：不指定接班人有助维持权威，指定接班人则可能提前形成新的权力中心。","blocks":[{"id":"52eb3565","type":"fragment","model":{"text":"此外，中国政坛至今没有明确的接班人。魏德曼和牛犇都认为，这反映习近平面临两难：不指定接班人有助维持权威，指定接班人则可能提前形成新的权力中心。","attributes":[]},"position":[21,7,1]}]},"position":[21,7]}]},"position":[21]},{"id":"ac483ff8","type":"relatedContent","model":{"blocks":[{"id":"dadf9ba0","type":"link","model":{"locator":"urn:bbc:optimo:asset:c6vgyzdjzl9ko","blocks":[{"id":"89efb7e1","type":"image","model":{"blocks":[{"id":"dd2c06ed","type":"altText","model":{"blocks":[{"id":"9e6a9d9b","type":"text","model":{"blocks":[{"id":"c3440586","type":"paragraph","model":{"text":"习近平","blocks":[{"id":"cd6556e0","type":"fragment","model":{"text":"习近平","attributes":[]},"position":[22,1,1,1,1,1,1]}]},"position":[22,1,1,1,1,1]}]},"position":[22,1,1,1,1]}]},"position":[22,1,1,1]},{"id":"3e76b96b","type":"rawImage","model":{"width":945,"height":531,"locator":"9972/live/29a84e10-b590-11f1-a6d4-5bd51477682a.jpg","originCode":"cpsprodpb","copyrightHolder":"Getty Images"},"position":[22,1,1,2]}]},"position":[22,1,1]},{"id":"70c0bf44","type":"text","model":{"blocks":[{"id":"d80e7273","type":"paragraph","model":{"text":"中共五中全会10月26日召开：聚焦“从严治党” 习近平政治地位新提法成看点","blocks":[{"id":"36db67b9","type":"urlLink","model":{"text":"中共五中全会10月26日召开：聚焦“从严治党” 习近平政治地位新提法成看点","locator":"https://www.bbc.com/zhongwen/articles/c6vgyzdjzl9ko/simp","blocks":[{"id":"5a505f02","type":"fragment","model":{"text":"中共五中全会10月26日召开：聚焦“从严治党” 习近平政治地位新提法成看点","attributes":[]},"position":[22,1,2,1,1,1]}],"isExternal":false},"position":[22,1,2,1,1]}]},"position":[22,1,2,1]}]},"position":[22,1,2]},{"id":"db9d849d","type":"aresLink","model":{"blocks":[{"id":"7ba97a46","type":"optimoLinkMetadata","model":{"timestamp":1789980572883,"consumableAsSFV":false},"position":[22,1,3,1]}]},"position":[22,1,3]},{"id":"66d95023","type":"aresLink","model":{"blocks":[{"id":"de69a150","type":"optimoLinkMetadata","model":{"timestamp":1789980572883,"consumableAsSFV":false},"position":[22,1,4,1]}]},"position":[22,1,4]}]},"position":[22,1]},{"id":"dba9ba9e","type":"link","model":{"locator":"urn:bbc:optimo:asset:cx27l1rz6xko","blocks":[{"id":"55d172a9","type":"image","model